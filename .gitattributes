# Set default behavior to auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Python Source Files
*.py text diff=python

# Documentation & Markup Files
*.md text
*.rst text
*.txt text
*.yml text
*.yaml text
*.json text
*.html text
*.css text
*.csv text

# Jupyter Notebooks
*.ipynb text

# Binary Files (Avoid line-ending conversions)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.parquet binary
*.pkl binary
*.joblib binary

# Custom Git attributes for model files & datasets
*.model binary
*.bin binary
