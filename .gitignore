# ==============================================================================
# .gitignore - Quantitative Financial Engineering & MLOps Architecture
# ==============================================================================

# 1. Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# 2. Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Virtual environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# 4. Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# 5. Testing / Coverage / Linting
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# 6. IDEs, Editors & System Files
.vscode/
.idea/
*.swp
*.swo
*~
.gemini/
.agents/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 7. Data Lakehouse & Heavy Storage (Ignore raw, bronze, silver, gold data except .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet
*.feather
*.h5
*.hd5
ds_assessment_data.csv

# 8. Databases, Feature Store Registry & Online Low-Latency Stores
*.db
*.sqlite
*.sqlite3
feature_store/data/
data/registry.db
data/online_store.db

# 9. MLflow Tracking & Run Artifacts
mlruns/
mlartifacts/
mlflow.db

# 10. Saved Machine Learning Model Binaries (Heavy files)
*.pkl
*.joblib
*.onnx
*.bin
*.model
models/*.pkl
!models/model_metadata.json
!models/.gitkeep

# 11. Generated Reports, Figures & Logs
*.log
reports/technical_report.html
reports/technical_report.pdf
reports/data_drift_report.html
!reports/figures/
!reports/figures/*.png
!reports/figures/.gitkeep

# 12. Markdown & Document Specifications Policy
*.md
**/*.md
README_MASTER.md
!README.md
!src/**/README.md
!src/**/*_SPEC.md
!src/**/*_SRS.md
*.docx

# 13. Scratch Temporary Scripts & Output Dumps
scratch/